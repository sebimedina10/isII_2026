<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Materias</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-3xl">

        <h1 class="text-3xl font-bold text-center text-gray-800 mb-2">Mis Materias</h1>
        <p class="text-xl text-center text-gray-700 mb-8">
            <span class="font-semibold text-cyan-600">{{username}}</span>
        </p>

        {{#tieneMaterias}}
        {{#materias}}
        <div class="bg-cyan-50 border border-cyan-200 p-5 rounded-lg shadow-sm mb-4">
            <div class="flex justify-between items-center mb-2">
                <h2 class="text-lg font-bold text-cyan-700">{{nombre_materia}}</h2>
                <span class="text-sm font-semibold px-3 py-1 rounded-full
                    {{#estado}}
                    bg-green-100 text-green-700
                    {{/estado}}">
                    {{estado}}
                </span>
            </div>
            <p class="text-sm text-gray-500 mb-3">
                Código: {{codigo}} | Año: {{anio_pertenece}} | Período: {{periodo}}
            </p>

            {{#tieneNotas}}
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="border-b border-cyan-200">
                        <th class="py-1 pr-4 text-gray-600">Tipo</th>
                        <th class="py-1 text-gray-600">Nota</th>
                    </tr>
                </thead>
                <tbody>
                    {{#notas}}
                    <tr class="border-b border-cyan-100">
                        <td class="py-1 pr-4 text-gray-700">{{tipo_nota}}</td>
                        <td class="py-1 font-semibold text-gray-800">{{valor}}</td>
                    </tr>
                    {{/notas}}
                </tbody>
            </table>
            {{/tieneNotas}}

            {{^tieneNotas}}
            <p class="text-sm text-gray-400 italic">Sin notas cargadas aún.</p>
            {{/tieneNotas}}
        </div>
        {{/materias}}
        {{/tieneMaterias}}

        {{^tieneMaterias}}
        <div class="bg-yellow-50 border border-yellow-200 p-6 rounded-lg text-center">
            <p class="text-gray-600">No estás inscripto en ninguna materia todavía.</p>
        </div>
        {{/tieneMaterias}}

        <div class="flex justify-center mt-6">
            <a href="/dashboard"
               class="inline-block bg-gray-500 text-white py-2 px-6 rounded-md hover:bg-gray-600 transition duration-300">
                Volver al inicio
            </a>
        </div>

    </div>
</body>
</html>