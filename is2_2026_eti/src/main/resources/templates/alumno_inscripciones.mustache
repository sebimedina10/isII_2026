<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Centro de Inscripciones</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 min-h-screen p-6">

<div class="max-w-7xl mx-auto">

    <div class="bg-white rounded-xl shadow-md p-6 mb-6 border border-gray-200 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-indigo-700">Centro de Inscripciones</h1>
            <p class="text-gray-500 mt-1">Gestioná tus carreras y materias.</p>
        </div>

        <a href="/dashboard" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium">← Volver</a>
    </div>

    {{#error}}
    <div class="bg-red-50 border border-red-300 text-red-700 px-4 py-3 rounded-lg mb-4">
        ⚠️ {{.}}
    </div>
    {{/error}}

    {{#success}}
    <div class="bg-green-50 border border-green-300 text-green-700 px-4 py-3 rounded-lg mb-4">
        ✅ {{.}}
    </div>
    {{/success}}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- CARRERAS -->
        <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">

            <h2 class="text-2xl font-bold text-indigo-700 mb-4">Inscripción a Carreras</h2>

            <form method="post" action="/alumno/inscribir-carrera" class="space-y-4">

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Carreras Disponibles</label>

                    <select name="id_carrera" class="w-full border border-gray-300 rounded-lg p-2" required>
                        <option value="">-- Seleccionar Carrera --</option>

                        {{#carrerasDisponibles}}
                        <option value="{{id_carrera}}">{{nombre_carrera}}</option>
                        {{/carrerasDisponibles}}
                    </select>
                </div>

                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-lg">
                    Inscribirme a la Carrera
                </button>

            </form>

            <div class="mt-8">

                <h3 class="text-lg font-bold text-gray-700 mb-3">Tus Carreras Actuales</h3>

                <div class="space-y-2">

                    {{#misCarreras}}
                    <div class="bg-gray-50 border border-gray-200 rounded-lg px-4 py-3">🎓 {{nombre_carrera}}</div>
                    {{/misCarreras}}

                    {{^misCarreras}}
                    <div class="text-gray-500 italic text-sm">No estás inscripto en ninguna carrera.</div>
                    {{/misCarreras}}
                </div>
            </div>
        </div>

        <!-- MATERIAS -->
        <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
            <h2 class="text-2xl font-bold text-green-700 mb-4">Inscripción a Materias</h2>
            <form method="get" action="/inscripcion/carrera" class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Carrera</label>
                    <select name="id_carrera" class="w-full border border-gray-300 rounded-lg p-2" required>
                        <option value="">-- Elegir Carrera --</option>
                        {{#misCarreras}}
                        <option value="{{id_carrera}}" {{#selected}}selected{{/selected}}>{{nombre_carrera}}</option>
                        {{/misCarreras}}
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Año</label>
                    <select name="anio_pertenece" class="w-full border border-gray-300 rounded-lg p-2">
                        <option value="">Todos</option>
                        <option value="1" {{#anio1}}selected{{/anio1}}>1er Año</option>
                        <option value="2" {{#anio2}}selected{{/anio2}}>2do Año</option>
                        <option value="3" {{#anio3}}selected{{/anio3}}>3er Año</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Cuatrimestre</label>
                    <select name="periodo" class="w-full border border-gray-300 rounded-lg p-2">
                        <option value="">Todos</option>
                        <option value="1C" {{#periodo1C}}selected{{/periodo1C}}>1er Cuatrimestre</option>
                        <option value="2C" {{#periodo2C}}selected{{/periodo2C}}>2do Cuatrimestre</option>
                    </select>
                </div>

                <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white py-2 rounded-lg">
                    Buscar Materias
                </button>
            </form>

            <div class="mt-8">

            <form method="post" action="/alumno/inscribir-materias">

                <input type="hidden" name="id_carrera" value="{{carreraSeleccionada}}">
                <input type="hidden" name="anio_pertenece" value="{{anioBusqueda}}">
                <input type="hidden" name="periodo" value="{{cuatriBusqueda}}">

                <div class="space-y-3">

                    {{#materiasDisponibles}}
                    <label class="flex items-center gap-4 border border-gray-200 rounded-lg p-4 cursor-pointer hover:bg-gray-50">
                        <input type="checkbox" name="materias" value="{{id_materia}}" class="w-5 h-5">

                        <div>
                            <p class="font-semibold text-gray-800">{{nombre_materia}}</p>
                            <p class="text-sm text-gray-500">{{nombre_carrera}} · {{anio_pertenece}}° Año · {{periodo}}</p>
                        </div>
                    </label>
                    {{/materiasDisponibles}}

                    {{^materiasDisponibles}}
                    {{#mensajeNoHayMaterias}}
                    <div class="text-gray-500 italic text-sm">{{mensajeNoHayMaterias}}</div>
                    {{/mensajeNoHayMaterias}}
                    {{^mensajeNoHayMaterias}}
                    <div class="text-gray-500 italic text-sm">No hay materias disponibles para mostrar.</div>
                    {{/mensajeNoHayMaterias}}
                    {{/materiasDisponibles}}

                </div>

                {{#hayMaterias}}
                <button type="submit" class="w-full mt-4 bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg">
                    Inscribirme a las materias seleccionadas
                </button>
                {{/hayMaterias}}

                {{#hayMateriasInscriptas}}
                <div class="mt-6 p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
                    <h3 class="text-sm font-semibold text-yellow-800 mb-3">Materias ya inscriptas</h3>
                    <div class="space-y-3">
                        {{#materiasInscriptas}}
                        <div class="flex items-center justify-between gap-4 border border-yellow-200 rounded-lg p-4 bg-yellow-25">
                            <div>
                                <p class="font-semibold text-yellow-900">{{nombre_materia}}</p>
                                <p class="text-sm text-yellow-700">{{nombre_carrera}} · {{anio_pertenece}}° Año · {{periodo}}</p>
                            </div>
                            <span class="inline-flex items-center rounded-full bg-yellow-100 text-yellow-800 text-xs font-semibold px-2.5 py-1">Ya inscripta</span>
                        </div>
                        {{/materiasInscriptas}}
                    </div>
                </div>
                {{/hayMateriasInscriptas}}

            </form>

        </div>
        </div>
    </div>
</div>

</body>
</html>