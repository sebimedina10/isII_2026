<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Asignar Docentes a Materias</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-4xl mx-auto bg-white p-8 rounded-2xl shadow-lg">
        
        <!-- CABECERA -->
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">Asignar Docentes a Materias</h1>
            <a href="/dashboard" class="bg-gray-500 text-white px-4 py-2 rounded-md hover:bg-gray-600">
                ← Volver al Dashboard
            </a>
        </div>

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            {{successMessage}}
        </div>
        {{/successMessage}}

        <!-- PASO 1: SELECCIONAR DEPARTAMENTO -->
        <div class="bg-blue-50 border border-blue-200 p-4 rounded-lg mb-6">
            <label for="filtro_facultad" class="block text-blue-900 font-bold mb-2">Filtrar por Departamento/Facultad:</label>
            <select id="filtro_facultad" onchange="cambiarFacultad(this.value)" class="w-full p-2 border border-blue-300 rounded-md">
                <option value="">-- Seleccionar Facultad --</option>
                {{#facultades}}
                <option value="{{id_facultad}}" {{#selected}}selected{{/selected}}>{{nombre}}</option>
                {{/facultades}}
            </select>
        </div>

        {{#facultadSeleccionada}}
        <!-- PASO 2: FORMULARIO DE ASIGNACIÓN -->
        <form action="/admin/asignar-docente" method="post" class="space-y-6 mb-8">
            <input type="hidden" name="id_facultad" value="{{facultadId}}">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- DOCENTES -->
                <div>
                    <label for="id_docente" class="block text-gray-700 font-bold mb-2">Docente:</label>
                    <select name="id_docente" id="id_docente" required class="w-full p-2 border rounded">
                        <option value="">-- Seleccionar Docente --</option>
                        {{#docentes}}
                        <option value="{{id}}">{{apellido}}, {{nombre}}</option>
                        {{/docentes}}
                    </select>
                    {{^docentes}}
                    <p class="text-sm text-red-500 mt-1">No hay docentes registrados en esta facultad.</p>
                    {{/docentes}}
                </div>

                <!-- MATERIAS -->
                <div>
                    <label for="id_materia" class="block text-gray-700 font-bold mb-2">Materia (de Carreras del departamento):</label>
                    <select name="id_materia" id="id_materia" required class="w-full p-2 border rounded">
                        <option value="">-- Seleccionar Materia --</option>
                        {{#materias}}
                        <option value="{{id_materia}}">[{{codigo}}] {{nombre_materia}} ({{nombre_carrera}})</option>
                        {{/materias}}
                    </select>
                    {{^materias}}
                    <p class="text-sm text-red-500 mt-1">No hay materias registradas en carreras de esta facultad.</p>
                    {{/materias}}
                </div>
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white font-bold py-2 rounded hover:bg-blue-700">
                Asignar Docente a Materia
            </button>
        </form>
        {{/facultadSeleccionada}}

        <!-- ASIGNACIONES EXISTENTES -->
        <h2 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">Asignaciones Actuales</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-100 text-gray-700 font-bold">
                        <th class="p-3 border">Docente</th>
                        <th class="p-3 border">Materia</th>
                        <th class="p-3 border">Carrera</th>
                        <th class="p-3 border text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    {{#asignaciones}}
                    <tr class="hover:bg-gray-50">
                        <td class="p-3 border text-gray-700">{{docente}}</td>
                        <td class="p-3 border text-gray-700">{{materia}}</td>
                        <td class="p-3 border text-gray-700">{{carrera}}</td>
                        <td class="p-3 border text-center">
                            <form action="/admin/asignar-docente/delete" method="post" onsubmit="return confirm('¿Seguro deseas eliminar esta asignación?');">
                                <input type="hidden" name="id_doc_mat" value="{{id_DocMat}}">
                                <button type="submit" class="bg-red-500 text-white px-2 py-1 rounded text-sm hover:bg-red-600">
                                    Quitar
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/asignaciones}}
                    {{^asignaciones}}
                    <tr>
                        <td colspan="4" class="p-4 text-center text-gray-500">No hay docentes asignados a materias actualmente.</td>
                    </tr>
                    {{/asignaciones}}
                </tbody>
            </table>
        </div>

    </div>

    <script>
        function cambiarFacultad(id) {
            if (id) {
                window.location.href = "/admin/asignar-docente?id_facultad=" + id;
            } else {
                window.location.href = "/admin/asignar-docente";
            }
        }
    </script>
</body>
</html>
