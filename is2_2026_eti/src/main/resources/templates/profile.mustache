<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Perfil</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-2xl">

        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Mi Perfil</h1>
        <p class="text-xl text-center text-gray-700 mb-8">
            <span class="font-semibold text-cyan-600">{{username}}</span>
        </p>

        <!-- Datos Personales -->
        <div class="bg-cyan-50 border border-cyan-200 p-6 rounded-lg shadow-sm mb-6">
            <h2 class="text-2xl font-bold text-cyan-700 mb-4">Datos Personales</h2>
            <table class="w-full text-left">
                <tr class="border-b border-cyan-100">
                    <th class="py-2 pr-4 text-gray-600 font-semibold w-1/3">Nombre</th>
                    <td class="py-2 text-gray-800">{{nombre}}</td>
                </tr>
                <tr class="border-b border-cyan-100">
                    <th class="py-2 pr-4 text-gray-600 font-semibold">Apellido</th>
                    <td class="py-2 text-gray-800">{{apellido}}</td>
                </tr>
                <tr class="border-b border-cyan-100">
                    <th class="py-2 pr-4 text-gray-600 font-semibold">DNI</th>
                    <td class="py-2 text-gray-800">{{dni}}</td>
                </tr>
                <tr class="border-b border-cyan-100">
                    <th class="py-2 pr-4 text-gray-600 font-semibold">Email</th>
                    <td class="py-2 text-gray-800">{{email}}</td>
                </tr>
                <tr class="border-b border-cyan-100">
                    <th class="py-2 pr-4 text-gray-600 font-semibold">Teléfono</th>
                    <td class="py-2 text-gray-800">{{telefono}}</td>
                </tr>
                <tr>
                    <th class="py-2 pr-4 text-gray-600 font-semibold">Nacimiento</th>
                    <td class="py-2 text-gray-800">{{fecha_nacimiento}}</td>
                </tr>
            </table>
        </div>

        <!-- Datos Académicos -->
<div class="bg-yellow-50 border border-yellow-200 p-6 rounded-lg shadow-sm mb-8">
    <h2 class="text-2xl font-bold text-yellow-700 mb-4">Datos Académicos</h2>
    <table class="w-full text-left">
        {{#isAlumno}}
        <tr>
            <th class="py-2 pr-4 text-gray-600 font-semibold w-1/3">Progreso</th>
            <td class="py-2 text-gray-800">{{progreso}}%</td>
        </tr>
        {{/isAlumno}}
        {{#isDocente}}
        <tr class="border-b border-yellow-100">
            <th class="py-2 pr-4 text-gray-600 font-semibold w-1/3">Título</th>
            <td class="py-2 text-gray-800">{{titulo}}</td>
        </tr>
        <tr>
            <th class="py-2 pr-4 text-gray-600 font-semibold">Rol</th>
            <td class="py-2 text-gray-800">{{rol}}</td>
        </tr>
        {{/isDocente}}
    </table>
</div>

<div class="flex justify-center">
            <a href="/dashboard"
            class="inline-block bg-gray-500 text-white py-2 px-6 rounded-md hover:bg-gray-600 transition duration-300">
                Volver al inicio
            </a>
        </div>

    </div>
</body>
</html>
