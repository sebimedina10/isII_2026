<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cargar Notas</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">

<div class="max-w-5xl mx-auto">

    <!-- Header -->
    <div class="bg-white rounded-xl shadow-md p-6 mb-6 border border-gray-200 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-indigo-700">Cargar Notas</h1>
            <p class="text-gray-500 mt-1">Seleccioná una materia para cargar notas a los alumnos.</p>
        </div>
        <a href="/dashboard" class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-4 py-2 rounded-lg text-sm font-medium">← Volver</a>
    </div>

    {{#error}}
    <div class="bg-red-50 border border-red-300 text-red-700 px-4 py-3 rounded-lg mb-4">⚠️ {{.}}</div>
    {{/error}}
    {{#success}}
    <div class="bg-green-50 border border-green-300 text-green-700 px-4 py-3 rounded-lg mb-4">✅ {{.}}</div>
    {{/success}}

    <!-- Selector de materia -->
    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6 mb-6">
        <h2 class="text-xl font-bold text-indigo-700 mb-4">Mis Materias</h2>
        {{#hayMaterias}}
        <form method="get" action="/docente/notas" class="flex gap-3 items-end">
            <div class="flex-1">
                <label class="block text-sm font-semibold text-gray-700 mb-1">Materia</label>
                <select name="id_materia" class="w-full border border-gray-300 rounded-lg p-2" required>
                    <option value="">-- Seleccionar materia --</option>
                    {{#materias}}
                    <option value="{{id_materia}}" {{#selected}}selected{{/selected}}>{{nombre_materia}}</option>
                    {{/materias}}
                </select>
            </div>
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-5 py-2 rounded-lg">
                Ver Alumnos
            </button>
        </form>
        {{/hayMaterias}}
        {{^hayMaterias}}
        <p class="text-gray-500 italic text-sm">No tenés materias asignadas. Contactá al administrador.</p>
        {{/hayMaterias}}
    </div>

    <!-- Alumnos y formulario de notas -->
    {{#hayAlumnos}}
    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-6">
        <h2 class="text-xl font-bold text-green-700 mb-4">Alumnos Inscriptos</h2>
        <div class="space-y-4">
            {{#alumnos}}
            <div class="border border-gray-200 rounded-lg p-4">

                <div class="mb-3">
                    <p class="font-semibold text-gray-800">{{apellido}}, {{nombre}}</p>
                    <p class="text-sm text-gray-500">DNI: {{dni}} · Estado: <span class="font-medium">{{estado}}</span></p>
                </div>

                <!-- Notas ya cargadas -->
                {{#hayNotas}}
                <div class="flex gap-2 flex-wrap mb-3">
                    {{#notas}}
                    <span class="bg-blue-50 border border-blue-200 text-blue-800 text-xs font-semibold px-3 py-1 rounded-full">
                        {{tipo_nota}}: {{valor}}
                    </span>
                    {{/notas}}
                </div>
                {{/hayNotas}}

                <!-- Formulario cargar nota -->
                <form method="post" action="/docente/notas/cargar" class="flex gap-2 items-end flex-wrap">
                    <input type="hidden" name="id_inscripcion" value="{{id_inscripcion}}">
                    <input type="hidden" name="id_materia" value="{{materiaSeleccionada}}">

                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Tipo de nota</label>
                        <select name="tipo_nota" class="border border-gray-300 rounded-lg p-2 text-sm" required>
                            <option value="">-- Tipo --</option>
                            <option value="PARCIAL">Parcial</option>
                            <option value="FINAL">Final</option>
                            <option value="TP">TP</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-600 mb-1">Nota (0–10)</label>
                        <input type="number" name="valor" min="0" max="10"
                               class="border border-gray-300 rounded-lg p-2 text-sm w-24" required>
                    </div>

                    <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm">
                        Guardar
                    </button>
                </form>
            </div>
            {{/alumnos}}
        </div>
    </div>
    {{/hayAlumnos}}

    {{#materiaSeleccionada}}
    {{^hayAlumnos}}
    <div class="bg-white rounded-xl shadow-md border border-gray-200 p-8 text-center">
        <p class="text-gray-500 italic">No hay alumnos inscriptos en esta materia.</p>
    </div>
    {{/hayAlumnos}}
    {{/materiaSeleccionada}}

</div>
</body>
</html>